# typethai-desktop --simulate transcripts, 2026-10-18
# Each input line: <SEL:prefix> selects that text, ^R is the (Ctrl+Opt+R) hotkey, <TabDown>3<TabUp> picks row 3.
# Command (Ollama running with gemma4:latest):
#   printf '<SEL:Please let me>^R<TabDown>3<TabUp>\n' | TYPETHAI_MODEL=/tmp/ttmodel/typethai.ttm \
#     rust/target/debug/typethai-desktop --simulate --state /tmp/ttsim/personal.json
# stdout follows, verbatim.

  [selected: "Please let me"]
  Hotkey(Rewrite) -> Rewrite(Capture(ReqId(1)))
  Hotkey(Rewrite) -> ShowBubble([BubbleItem { label: "Fix typos", kind: Rewrite(Preset(Fix, "Please let me")) }, BubbleItem { label: "Translate TH↔EN", kind: Rewrite(Preset(Translate, "Please let me")) }, BubbleItem { label: "Finish sentence locally", kind: Rewrite(Preset(Finish, "Please let me")) }])
  [bubble: >Fix typos |  Translate TH↔EN |  Finish sentence locally]
  Tab -> (swallowed)
  Char('3') -> ShowBubble([BubbleItem { label: "Finishing locally…", kind: Rewrite(Busy(ReqId(2))) }])
  Char('3') -> Rewrite(Run(Run { req: ReqId(2), preset: Finish, text: "Please let me", cfg: Config { enabled: true, base_url: "https://openrouter.ai/api/v1", model: "google/gemma-4-26b-a4b-it", instructions: "" } }))
  Char('3') -> ShowBubble([BubbleItem { label: "Please let me know if you need any further assistance.", kind: Rewrite(Result("Please let me know if you need any further assistance.")) }])
  [bubble: >Please let me know if you need any further assistance.]
  TabUp -> (swallowed)
  Enter -> HideBubble
  Enter -> Rewrite(Paste("Please let me know if you need any further assistance."))

